APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=55700
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mtg:mtg@postgres:5432/mtg_deck_doctor

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=mtg.analysis
RABBITMQ_DLQ=mtg.analysis.dlq

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional OpenAI-compatible endpoint (e.g. DeepSeek: https://api.deepseek.com)
LLM_BASE_URL=

SCRYFALL_BASE_URL=https://api.scryfall.com
SCRYFALL_USER_AGENT=MTGDeckDoctor/1.0

MAX_CARDS_PER_DECK=100
MAX_CARD_NAME_LENGTH=120
MAX_RECOMMENDATIONS=3

SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=1

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
